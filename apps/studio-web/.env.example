# PostgreSQL Database Connection URL -- see docker-compose.yml for the local container
GLUMACKI_DATABASE_URL="postgresql://glumacki:glumacki@localhost:5433/glumacki?schema=public"

# NextAuth -- generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Facebook OAuth (developers.facebook.com -> your app -> Settings -> Basic)
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# Email -- Resend (resend.com). Left unset, registration/approval emails
# just log to the console instead of sending (see lib/email/).
RESEND_API_KEY=""
RESEND_SEND_ADDRESS=""

# Vercel Blob Storage -- for storing scripts and media
BLOB_READ_WRITE_TOKEN=""

# LiveKit -- rehearsal live video (cloud.livekit.io project settings, or your
# self-hosted server). LIVEKIT_URL is the wss:// server URL; the API key/secret
# mint per-user room tokens server-side (see lib/workshops/live.ts). COR-19
# tracks whether this should go through the Vercel Marketplace instead.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
